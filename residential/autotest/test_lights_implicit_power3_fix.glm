// $Id: test_lights_implicit_power3.glm 4738 2014-07-03 00:55:39Z dchassin $
// Test: Single lights object inside of a house with an implicit schedue for the Weekday Winter.
// ID: D3P706


#set suppress_repeat_messages=0

clock {
	timezone PST+8PDT;
	starttime '2001-03-28 00:00:00 PST';
	stoptime '2001-03-29 00:00:00 PST';
}

module residential {
	implicit_enduses LIGHTS;
}
module assert;
module tape;

object house {
  name "autogen_house_0";
	heating_setpoint 5;
	cooling_setpoint 300;
	air_temperature 70;
	outdoor_temperature 73;
	object recorder{
	  parent "autogen_house_0";
	  name "autogen_house_0_recorder_0";
		property panel;
		file "test_lights_implicit_power.csv";
		interval 3600;
		limit 10000;
	};
	object complex_assert {
	  parent "autogen_house_0";
	  name "autogen_house_0_complex_assert_0";
	  name "autogen_complex_assert_0";
		target "panel.power";
		within 1;
		object player {
		  parent "autogen_complex_assert_0";
			property value;
			file "../test_lights_explicit_power3.player";
			loop 1;
		};
	};
}


